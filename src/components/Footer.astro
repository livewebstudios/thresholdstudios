---
// Footer: logo, address, phone, email, appointment line, socials, page links, copyright, LWS badge.
import Hairline from './kit/Hairline.astro';
import { site, nav } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="footer" id="site-footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" class="footer__logo"><img src="/images/logoRGB.png" alt={site.name} width="96" height="96" loading="lazy" /></a>
        <p class="footer__line">Legendary recording, mixing and mastering in Hell's Kitchen since 1997.</p>
      </div>
      <div class="footer__col">
        <p class="mono footer__head">THE STUDIO</p>
        <address>
          {site.name}<br />
          {site.address.street}<br />
          {site.address.between}<br />
          {site.address.neighborhood}, {site.address.city}, {site.address.region} {site.address.zip}
        </address>
        <p class="mono mono--sm footer__appt">BY APPOINTMENT ONLY · NO WALK-INS</p>
      </div>
      <div class="footer__col">
        <p class="mono footer__head">CALL OR WRITE</p>
        <p><a class="footer__phone mono" href={site.phoneHref}>{site.phone}</a></p>
        <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <ul role="list" class="footer__social mono mono--sm" aria-label="Social">
          <li><a href={site.social.instagram} rel="noopener">INSTAGRAM</a></li>
          <li><a href={site.social.facebook} rel="noopener">FACEBOOK</a></li>
          <li><a href={site.social.twitter} rel="noopener">X / TWITTER</a></li>
        </ul>
      </div>
      <nav class="footer__col" aria-label="Footer">
        <p class="mono footer__head">PAGES</p>
        <ul role="list" class="footer__pages mono">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
    </div>
    <Hairline class="footer__rule" />
    <div class="footer__base">
      <p class="mono mono--sm">© {year} Threshold Recording Studios NYC. All rights reserved.</p>
      <a class="footer__lws" href="https://livewebstudios.com" rel="noopener">
        <img src="/images/verifiedsecured.png" alt="Live Web Studios verified and secured badge" width="150" height="37" loading="lazy" />
        <span class="mono mono--sm">Built by Live Web Studios</span>
      </a>
    </div>
  </div>
</footer>
<style>
  .footer {
    background: var(--th-charcoal);
    border-top: 1px solid var(--th-hairline);
    padding-block: var(--s-20) var(--s-10);
    color: var(--th-parchment);
    font-size: 1rem;
  }
  .footer__grid { display: grid; gap: var(--s-10); grid-template-columns: 1fr; }
  .footer__logo img { width: 96px; height: 96px; }
  .footer__line { margin-top: var(--s-4); max-width: 26ch; font-family: var(--font-display); font-weight: var(--fw-display); font-size: 1.25rem; line-height: 1.3; color: var(--th-cream); }
  .footer__head { color: var(--th-brass); margin-bottom: var(--s-4); }
  .footer address { font-style: normal; line-height: 1.6; }
  .footer__appt { margin-top: var(--s-4); }
  .footer a { color: var(--th-cream); text-decoration-color: color-mix(in srgb, var(--th-brass) 50%, transparent); }
  .footer a:hover { color: var(--th-brass-bright); }
  .footer__phone { display: inline-flex; align-items: center; min-height: 44px; font-size: 1.25rem; letter-spacing: 0.1em; text-decoration: none; }
  .footer__col p + p { margin-top: var(--s-2); }
  .footer__social { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); margin-top: var(--s-5); }
  .footer__social a, .footer__pages a { text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  .footer__social { row-gap: 0; }
  .footer__pages { gap: 0; }
  .footer__pages a { min-width: 44px; }
  .footer__pages { display: grid; gap: var(--s-1); }
  .footer :global(.footer__rule) { margin-block: var(--s-12) var(--s-6); }
  .footer__base { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s-5); }
  .footer__lws { display: inline-flex; align-items: center; min-height: 44px; gap: var(--s-3); text-decoration: none; }
  .footer__lws img { width: 150px; height: auto; opacity: 1; }
  @media (min-width: 720px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .footer__grid { grid-template-columns: 1.3fr 1fr 1fr 0.7fr; } }
</style>
