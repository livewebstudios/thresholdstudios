---
// Base surface: charcoal face, steel hairline, top-edge highlight, soft drop shadow, four screws.
// variant="walnut" adds walnut end-cheeks left and right.
import Screws from './Screws.astro';
interface Props {
  as?: 'div' | 'section' | 'article' | 'aside' | 'li' | 'figure';
  variant?: 'default' | 'walnut' | 'raised';
  class?: string;
  screws?: boolean;
  [key: string]: unknown;
}
const { as: Tag = 'div', variant = 'default', class: cls = '', screws = true, ...rest } = Astro.props;
---
<Tag class:list={['panel', `panel--${variant}`, cls]} {...rest}>
  {screws && <Screws />}
  <slot />
</Tag>
<style is:global>
  .panel {
    position: relative;
    background: var(--th-charcoal);
    border-radius: var(--r-panel);
    box-shadow: var(--shadow-inset), inset 0 2px 0 var(--th-edge-light), var(--shadow-panel);
    isolation: isolate;
  }
  .panel::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(180deg, color-mix(in srgb, var(--th-cream) 3.5%, transparent), transparent 40%);
    pointer-events: none;
    z-index: -1;
  }
  .panel--raised { background: var(--th-graphite); }
  .panel--walnut { margin-inline: 10px; }
  .panel--walnut::before,
  .panel--walnut::after {
    content: '';
    position: absolute;
    inset: 0 auto 0 -10px;
    width: 12px;
    z-index: -1;
    border-radius: 4px 0 0 4px;
    background:
      repeating-linear-gradient(178deg, color-mix(in srgb, var(--th-black) 22%, transparent) 0 2px, transparent 2px 6px, color-mix(in srgb, var(--th-wood-sheen) 6%, transparent) 6px 7px, transparent 7px 11px),
      linear-gradient(90deg, var(--th-walnut-dark), var(--th-walnut-mid) 55%, var(--th-walnut));
    box-shadow: inset 1px 0 0 color-mix(in srgb, var(--th-wood-sheen) 14%, transparent), -6px 18px 30px -18px color-mix(in srgb, var(--th-black) 90%, transparent);
  }
  .panel--walnut::after {
    inset: 0 -10px 0 auto;
    border-radius: 0 4px 4px 0;
    background:
      repeating-linear-gradient(182deg, color-mix(in srgb, var(--th-black) 22%, transparent) 0 2px, transparent 2px 6px, color-mix(in srgb, var(--th-wood-sheen) 6%, transparent) 6px 7px, transparent 7px 11px),
      linear-gradient(90deg, var(--th-walnut), var(--th-walnut-mid) 45%, var(--th-walnut-dark));
    box-shadow: inset -1px 0 0 color-mix(in srgb, var(--th-wood-sheen) 10%, transparent), 6px 18px 30px -18px color-mix(in srgb, var(--th-black) 90%, transparent);
  }
</style>
