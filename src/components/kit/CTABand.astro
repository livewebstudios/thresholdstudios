---
// Closing call-to-action panel. Centered for once.
import Panel from './Panel.astro';
import Button from './Button.astro';
import { site } from '../../data/site';
interface Props { title: string }
const { title } = Astro.props;
---
<section class="section cta" aria-labelledby="cta-title">
  <div class="container">
    <Panel variant="raised" class="cta__panel" data-reveal>
      <h2 id="cta-title" class="cta__title">{title}</h2>
      <a class="cta__phone mono" href={site.phoneHref}>{site.phone}</a>
      <Button href={site.phoneHref}>BOOK A SESSION</Button>
      <p class="cta__policy">{site.policies.line}</p>
    </Panel>
  </div>
</section>
<style>
  .cta__panel {
    display: grid;
    justify-items: center;
    gap: var(--s-6);
    padding: clamp(3rem, 2rem + 4vw, 5.5rem) var(--s-6);
    text-align: center;
    background:
      radial-gradient(60% 80% at 50% 0%, color-mix(in srgb, var(--th-amber) 8%, transparent), transparent 70%),
      var(--th-graphite);
  }
  .cta__title { font-size: var(--fs-cta); max-width: 18ch; }
  .cta__phone {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.25rem);
    letter-spacing: 0.12em;
    color: var(--th-brass);
    text-decoration: none;
    font-weight: 500;
  }
  .cta__phone:hover { color: var(--th-brass-bright); }
  .cta__policy { color: var(--th-parchment); max-width: 44ch; font-size: 1rem; }
</style>
