---
// Mono breadcrumb trail. The last item is the current page.
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs mono" aria-label="Breadcrumb">
  <ol role="list">
    {items.map((it, i) => (
      <li>
        {it.href && i < items.length - 1 ? <a href={it.href}>{it.label}</a> : <span aria-current="page">{it.label}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.5rem; color: var(--th-parchment); }
  .crumbs li + li::before { content: '/'; margin-right: 0.5rem; color: var(--th-steel); }
  .crumbs ol { align-items: center; }
  .crumbs a { display: inline-flex; align-items: center; min-height: 44px; min-width: 44px; text-decoration: none; color: var(--th-brass); }
  .crumbs { margin-block: calc(-1 * var(--s-3)); }
  .crumbs a:hover { color: var(--th-brass-bright); }
</style>
