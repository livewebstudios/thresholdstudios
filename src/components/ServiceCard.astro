---
// Full service card (handoff 6.4): Panel, 4:3 thumbnail, brass number, name, copy, stub DETAILS link, group tag.
import Screws from './kit/Screws.astro';
import PhotoFrame from './kit/PhotoFrame.astro';
import type { Service } from '../data/services';
import { servicesPage } from '../data/pages/services';
interface Props { service: Service }
const { service: s } = Astro.props;
---
<li class="card service-card panel" data-group={s.group} id={`svc-${s.slug}`} data-reveal>
  <Screws />
  <PhotoFrame photoKey={s.thumb} ratio="4/3" sizes="(min-width: 1200px) 30vw, (min-width: 720px) 45vw, 100vw" class="card__thumb" parallax={false} />
  <div class="card__body">
    <span class="nameplate nameplate--num card__num">{s.num}</span>
    <h3 class="card__name">{s.name}</h3>
    <p class="card__copy">{s.copy}</p>
    <div class="card__foot">
      <a class="textlink" href={`/services/${s.slug}/`} data-stub={servicesPage.toast}>DETAILS →<span class="visually-hidden"> about {s.name}</span></a>
      <span class="mono mono--sm card__group">{s.group}</span>
    </div>
  </div>
</li>
<style>
  .card {
    display: flex;
    flex-direction: column;
    padding: 8px 8px 0;
    scroll-margin-top: calc(var(--nav-h) + var(--logo-hang) + var(--s-6));
    transition: transform var(--t-hover) var(--ease), box-shadow var(--t-hover) var(--ease);
  }
  .card :global(.pf) { box-shadow: none; padding: 0; background: none; }
  .card__body { position: relative; display: grid; gap: var(--s-3); padding: var(--s-6) var(--s-4) var(--s-5); flex: 1; grid-template-rows: auto auto 1fr auto; }
  .card__num { position: absolute; top: -0.75rem; left: var(--s-4); }
  .card__name { font-size: var(--fs-h3); line-height: 1.15; }
  .card__copy { font-size: 1rem; line-height: 1.55; color: var(--th-parchment); }
  .card__foot { display: flex; justify-content: space-between; align-items: center; gap: var(--s-3); padding-top: var(--s-4); border-top: 1px solid var(--th-hairline-soft); }
  .card__group { color: var(--th-steel); }
  @media (hover: hover) and (pointer: fine) {
    .card:hover { transform: translateY(-3px); box-shadow: var(--shadow-inset), inset 0 2px 0 var(--th-edge-light), var(--shadow-panel-hover); }
    .card:hover .card__num { filter: brightness(1.12); }
    .card:hover :global(.pf__img img) { filter: brightness(1.06); }
  }
  @media (min-width: 1200px) {
    .card { flex-direction: row; align-items: stretch; padding: 8px; gap: var(--s-2); }
    .card > :global(.pf) { flex: 0 0 46%; align-self: start; }
    .card__body { padding: var(--s-8) var(--s-5) var(--s-2) var(--s-5); }
    .card__num { top: var(--s-4); left: auto; right: var(--s-4); }
  }
  .card:target { box-shadow: 0 0 0 2px var(--th-brass), var(--shadow-panel); }
</style>
